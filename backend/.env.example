# ---- Core ----
NODE_ENV=development
PORT=4000
# Comma separated list, or * in dev
CORS_ORIGIN=*

# ---- Database ----
DATABASE_URL="postgresql://gameon:gameon@localhost:5433/gameon?schema=public"

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# OTP driver: mock (logs + returns code) | twilio | msg91
OTP_DRIVER=mock
OTP_TTL_SECONDS=300
# In dev, any phone can log in with this code. Leave empty to force real OTP flow.
OTP_DEV_CODE=000000

# Google / Apple sign-in (leave empty to disable those buttons)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ---- Payments ----
# mock | razorpay | stripe
PAYMENT_DRIVER=mock
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform commission in basis points (500 = 5%)
PLATFORM_FEE_BPS=500

# ---- Push notifications ----
# mock | fcm
PUSH_DRIVER=mock
FCM_SERVER_KEY=

# ---- Maps (used by the mobile app, mirrored here for geocoding) ----
GOOGLE_MAPS_API_KEY=
